{
  "name": "@saltroping/retriever",
  "version": "0.2.1",
  "type": "module",
  "bin": {
    "retriever": "./dist/index.js",
    "retr": "./dist/index.js"
  },
  "files": [
    "dist",
    "config.example.json"
  ],
  "description": "Personal agent daemon: one chat surface, child sessions that return to the main agent, and scheduled wakeups; pluggable channel and agent adapters",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Saltro Ping",
  "homepage": "https://github.com/Saltro/retriever#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saltro/retriever.git"
  },
  "bugs": {
    "url": "https://github.com/Saltro/retriever/issues"
  },
  "keywords": [
    "agent",
    "daemon",
    "personal-assistant",
    "cli",
    "chatops",
    "feishu",
    "lark",
    "cron",
    "automation"
  ],
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "rsbuild build && node scripts/fix-bin.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "tsx test/smoke.ts",
    "test": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:unit && pnpm run smoke",
    "test:unit": "tsx test/storage.ts && tsx test/runner.ts && tsx test/agents.ts && tsx test/sessions.ts && tsx test/channels.ts && tsx test/lifecycle.ts && tsx test/update.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@rsbuild/core": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
