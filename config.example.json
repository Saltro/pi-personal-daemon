{
  "agent": {
    "sessionId": "personal-agent",
    "cwd": "/tmp/pi-personal-daemon-workspace",
    "piBin": "pi",
    "extraArgs": ["--no-approve"],
    "mock": false
  },
  "channel": {
    "type": "feishu"
  },
  "agentProfiles": {
    "research": {
      "backend": "pi",
      "piBin": "pi",
      "extraArgs": [],
      "commandTimeoutMs": 30000,
      "cwd": "/path/to/research-workspace"
    },
    "local-cli": {
      "backend": "process",
      "command": "/path/to/agent-cli",
      "args": [],
      "promptMode": "stdin",
      "timeoutMs": 600000,
      "cwd": "/path/to/workspace"
    }
  },
  "http": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8787,
    "path": "/feishu/webhook"
  },
  "stdin": {
    "enabled": true
  },
  "sender": {
    "type": "mock",
    "mockOutbox": "/tmp/pi-personal-daemon-workspace/pi-personal-daemon/outbox.jsonl"
  },
  "feishu": {
    "appId": "",
    "appSecret": "",
    "verificationToken": "",
    "encryptKey": "",
    "baseUrl": "https://open.feishu.cn",
    "eventMode": "ws"
  },
  "runtime": {
    "contextFile": "/tmp/pi-personal-daemon-current-context.json",
    "stateDir": "/tmp/pi-personal-daemon-workspace/.cache/pi-personal-daemon"
  },
  "scheduler": {
    "enabled": true,
    "wakeups": [
      {
        "id": "hourly-note",
        "cron": "0 * * * *",
        "prompt": "Active wakeup: briefly inspect context and decide whether to send a short personal note."
      },
      {
        "id": "morning-check",
        "cron": "30 9 * * *",
        "prompt": "Morning wakeup: review memory and decide whether a short Feishu note would be useful."
      },
      {
        "id": "dev-fast-loop",
        "intervalMs": 3600000,
        "prompt": "Development interval wakeup: verify the scheduler path."
      }
    ]
  },
  "runtimeCronExamples": [
    "pi-personal-daemon cron create --id hourly-note --cron '0 * * * *' --prompt 'Hourly wakeup' --target main",
    "pi-personal-daemon cron create --id one-shot --at '2026-10-21T09:30:00+08:00' --prompt 'One-shot wakeup' --target new"
  ]
}
